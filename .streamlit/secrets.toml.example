# On Streamlit Community Cloud: App menu > Settings > Secrets, paste these (with your real values).
# Locally: copy this file to .streamlit/secrets.toml (git-ignored).
DHAN_CLIENT_ID = "your-dhan-client-id"
DHAN_ACCESS_TOKEN = "paste-todays-token-here"   # expires every 24 hours - update each morning
APP_PASSWORD = "choose-a-password"               # strongly recommended on a hosted app
# ANTHROPIC_API_KEY = "optional, enables Claude trade review"
